# Copy this file to .env and fill in your values. .env is gitignored.
# All settings are read in one place: src/config.py

# --- Environment: local | development | production ---
ENV=local

# --- API keys ---
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Models ---
OPENAI_MODEL=gpt-4-turbo-preview
TABLE_TO_IMAGE_OPENAI_MODEL=gpt-4-vision-preview

# --- Services ---
REDIS_SERVER_ADDRESS=localhost
REDIS_PORT=6379
# Path (relative to project root) to a Google Cloud service-account JSON with Translate API access
GOOGLE_TRANSLATE_AUTH_FILE=google_translate.json
# Optional basic auth for the Gradio demo (leave blank to disable)
DEMO_USERNAME=
DEMO_PASSWORD=

# --- AWS (only used when ENV is not "local") ---
AWS_REGION=us-east-1
# Secrets Manager secret holding a JSON object of the API keys above
AWS_SECRETS_NAME=
# Secrets Manager secret holding the Google service-account JSON
GOOGLE_TRANSLATE_SECRET_NAME=
# S3 bucket with source documents and test docs
DOCS_S3_BUCKET=
# S3 prefix with model folders, e.g. s3://my-bucket/models
MODELS_S3_URI=
# Optional S3 bucket for the table-OCR cache
REMOTE_CACHE_S3_BUCKET=
