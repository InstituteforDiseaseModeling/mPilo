FROM --platform=linux/amd64 nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04

# Make the default shell bash (vs "sh") for a better Jupyter terminal UX
ENV SHELL=/bin/bash

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y git-all ninja-build python3 python3-pip \
    python-is-python3 python-dev-is-python3 awscli build-essential curl wget git-lfs ffmpeg libsm6 libxext6 poppler-utils \
    tesseract-ocr nano redis-server systemctl && \
    rm -rf /var/lib/apt/lists/*

RUN pip install ipykernel && python3 -m ipykernel install --sys-prefix

COPY . /root/mpilo

WORKDIR /root/mpilo

# Install requirements
RUN pip install --upgrade pip && pip install -e . && \
pre-commit install --install-hooks && nbstripout --install --system
